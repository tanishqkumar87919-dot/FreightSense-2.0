# ==============================================================================
# FreightSense 2.0 - Environment Configuration Template
# Never commit actual secrets. Provide .env.example only.
# ==============================================================================

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# FASTAPI ML SERVICE (Deployed on Render)
FASTAPI_BASE_URL=https://freightsense-2-0.onrender.com
NEXT_PUBLIC_FASTAPI_BASE_URL=https://freightsense-2-0.onrender.com
API_INTERNAL_SECRET=your-internal-service-secret-token
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://freightsense.vercel.app

# MAPBOX GEOSPATIAL VISUALIZATION
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# AUTHORITATIVE DATA SOURCES
COMTRADE_API_KEY=your-un-comtrade-api-key
MARINETRAFFIC_API_KEY=your-marinetraffic-api-key
NOAA_API_TOKEN=your-noaa-cdo-token
FRED_API_KEY=your-stlouisfed-fred-api-key
EIA_API_KEY=your-us-eia-v2-api-key

# OPTIONAL / LICENSED COMMERCIAL PROVIDERS
BALTIC_API_KEY=your-baltic-exchange-license-key
OTHER_PROVIDER_KEYS=

# ML PIPELINE & CONTINUOUS LEARNING
MODEL_REGISTRY_BUCKET=freightsense-models
MODEL_ARTIFACT_BASE_PATH=artifacts/models
DEFAULT_MODEL_VERSION=v2.5
RETRAINING_ENABLED=false
AUTO_PROMOTION_ENABLED=false
